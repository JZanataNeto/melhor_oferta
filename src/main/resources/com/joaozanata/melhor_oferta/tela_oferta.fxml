<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joaozanata.melhor_oferta.OfertasController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <Label text="Calculadora da melhor oferta" textFill="LIME">
        <font>
          <Font size="18.0" />
        </font>
    </Label>
    <Label text="Cadastre 3 ofertas do produto. Para recalcular clique em limpar" textFill="LIME">
        <font>
          <Font size="14.0" />
        </font>
    </Label>
    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
        <TextField fx:id="txtProduto" promptText="produto" stylesheets="@style.css" />
        <TextField fx:id="txtPreco" promptText="preço" stylesheets="@style.css" />
        <TextField fx:id="txtFrete" promptText="frete" stylesheets="@style.css" />
        <TextField fx:id="txtPrazo" promptText="prazo" stylesheets="@style.css" />
    </HBox>
    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
        <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvar" style="-fx-background-color: #00ff00;" text="Salvar">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#atualizar" style="-fx-background-color: #00ff00;" text="Atualizar">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button fx:id="btnApagar" mnemonicParsing="false" onAction="#apagar" style="-fx-background-color: #00ff00;" text="Apagar">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
        <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#limpar" style="-fx-background-color: #00ff00;" text="Limpar">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Button>
    </HBox>
    <TableView fx:id="tblProduto" maxHeight="118.0" prefHeight="200.0" prefWidth="200.0" stylesheets="@style.css">
      <columns>
          <TableColumn fx:id="clProduto" prefWidth="75.0" text="produto" />
          <TableColumn fx:id="clPreco" prefWidth="75.0" text="preco" />
          <TableColumn fx:id="clFrete" prefWidth="75.0" text="frete" />
          <TableColumn fx:id="clPrazo" prefWidth="75.0" text="prazo" />
      </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
    <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
        <Label text="Selecione qualquer linha e clique em Calcular" textAlignment="JUSTIFY" textFill="LIME" wrapText="true" />
        <TextField fx:id="txtResultado" promptText="Best Oferta" stylesheets="@style.css" />
        <Button fx:id="btnCalcular" mnemonicParsing="false" onAction="#calcularBestOferta" style="-fx-background-color: #00ff00;" text="Calcular" />
    </HBox>
</VBox>
